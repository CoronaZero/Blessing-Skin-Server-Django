# Blessing Skin Server (Django) 环境变量样例
# 命名与 PHP 原版 .env 保持一致，迁移时可直接套用

# ---- 应用 ----
# 生产必须：签名密钥（用于 session/签名 URL 等），生成方式见 README
SECRET_KEY=
# 生产必须：逗号分隔的站点域名
ALLOWED_HOSTS=
# 生产置 false；缺省时开发模式默认 true
DEBUG=false

# ---- 数据库（sqlite [默认] / mysql / pgsql）----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blessing
DB_USERNAME=blessing
DB_PASSWORD=

# phpMyAdmin 方言注意：SQLite 时 DB_DATABASE 即数据库文件路径，缺省为 ./db.sqlite3
