# Blessing Skin Server (Django) 环境变量样例
# 仅基础设施级配置走环境变量；站点业务配置（邮件 SMTP、站点名等）
# 在管理后台的"站点选项"中配置（存 Option 表，运行时生效）

# ---- 应用 ----
# 生产必须：签名密钥，生成方式见 README
SECRET_KEY=
# 生产必须：逗号分隔的站点域名
ALLOWED_HOSTS=
# 生产置 false；缺省时开发模式默认 true
DEBUG=false
# 显示时区（IANA 名称；仅影响页面时间显示与日志渲染，数据库恒存 UTC）
# 例：TIME_ZONE=Asia/Shanghai ；留空/注释则为 UTC
TIME_ZONE=
# 生产（HTTPS 反代部署）建议置 1：Session/CSRF Cookie 仅经 HTTPS 传输，
# 防止 cookie 明文泄露；HTTP 部署保持 0
COOKIE_SECURE=
# 客户端 IP 识别的可信代理层数（Django 直连代理链：反代/CDN 各算一层）：
# 单层反代（默认 1）取 X-Forwarded-For 末跳；前置 CDN 时设 2——末跳是
# CDN 节点 IP，真实客户端在倒数第二跳；每加一层可信代理 +1。
# 宁少勿多：多配会采信客户端自带的可伪造段
CLIENT_IP_PROXY_DEPTH=

# ---- 数据库（sqlite [默认] / mysql / pgsql）----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blessing
DB_USERNAME=blessing
DB_PASSWORD=

# SQLite 时 DB_DATABASE 即数据库文件路径，缺省为 ./db.sqlite3
# PHP 迁移场景的密码盐（SALTED2* 算法历史用户校验需要）
SALT=
